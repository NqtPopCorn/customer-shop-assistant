# Application Settings
APP_NAME="Customer Shop Assistant"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# LLM Provider Configuration ("ollama" or "lmstudio")
LLM_PROVIDER="lmstudio"
TEMPERATURE=0.0
# SEED=42
TIMEOUT=60.0

# Ollama LLM & Embedding Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# LM Studio LLM Settings (OpenAI-compatible)
LMSTUDIO_BASE_URL="http://127.0.0.1:1235/v1"
LMSTUDIO_MODEL="google/gemma-4-e2b"
LMSTUDIO_API_KEY="lm-studio"

# Main E-commerce Backend API Settings (fashion-shop-be NestJS REST API)
MAIN_BE_BASE_URL="http://localhost:3000/api"
MAIN_BE_TIMEOUT=5.0

