  "guidelines": {
    "boundary_strategy": "Nếu chiều cao và cân nặng nằm giữa hai size kề cận (ví dụ 1m72, 65kg nằm giữa M và L), bot sẽ đề xuất cả hai size kèm tư vấn: chọn size nhỏ hơn nếu thích mặc ôm vừa người (Slim/Regular Fit), hoặc chọn size lớn hơn nếu thích mặc rộng rãi thoải mái (Loose/Oversize).",
    "review_fit_adjustment": {
      "min_reviews_threshold": 10,
      "rules": [
        {
          "signal": "TIGHT",
          "description": "Đa số khách hàng đánh giá form nhỏ/chật hơn bình thường",
          "action": "Khuyến nghị khách hàng cân nhắc tăng 1 size so với bảng quy chuẩn nếu thích mặc thoải mái"
        },
        {
          "signal": "LOOSE",
          "description": "Đa số khách hàng đánh giá form rộng/to hơn bình thường",
          "action": "Khuyến nghị khách hàng cân nhắc giảm 1 size nếu thích mặc vừa vặn cơ thể"
        },
        {
          "signal": "TRUE_TO_SIZE",
          "description": "Form dáng chuẩn theo bảng size",
          "action": "Khuyến nghị khách hàng chọn đúng size theo bảng quy chuẩn"
        }
      ]
    }
